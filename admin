-- ========================== КОМАНДЫ ==========================
local commands = {}
local function getPlayersByPartial(name)
    local found = {}
    local lower = name:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():sub(1, #lower) == lower or plr.DisplayName:lower():sub(1, #lower) == lower then
            table.insert(found, plr)
        end
    end
    return found
end

local function registerCommand(name, desc, func, aliases)
    commands[name] = {desc = desc, exec = func}
    if aliases then
        for _, a in ipairs(aliases) do commands[a] = {desc = desc, exec = func} end
    end
end

-- Команды
registerCommand("reset", "Reset your character (kill yourself)", function(args, plr)
    if plr.Character and plr.Character:FindFirstChild("Humanoid") then
        plr.Character.Humanoid.Health = 0
        return "Reset executed"
    end
    return "No character to reset"
end)

registerCommand("goto", "Teleport to player (goto <name>)", function(args, plr)
    if not args[2] then return "Usage: goto <player name>" end
    local matches = getPlayersByPartial(args[2])
    if #matches == 0 then return "Player not found" end
    local target = matches[1]
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        plr.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
        return "Teleported to " .. target.Name
    end
    return "Character missing"
end)

registerCommand("speed", "Set walkspeed (speed <num>)", function(args, plr)
    if args[2] and tonumber(args[2]) then
