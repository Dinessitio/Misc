    local search = cmdInput.Text:gsub("^[;/]", "")
    if search == "" then
        suggestionFrame.Visible = false
        return
    end
    for _, child in ipairs(suggestionFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local suggestions = {}
    for cmdName, data in pairs(commands) do
        if cmdName:find(search, 1, true) then
            table.insert(suggestions, cmdName)
