local function startKeyCapture()
    if isWaitingForInput then return end
    isWaitingForInput = true
    setKeyBtn.Text = "Press..."
    setKeyBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 100)
    statusLabel.Text = "Press any key on your keyboard..."

    waitingConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            toggleKey = input.KeyCode
            updateKeyDisplay()
            finishKeyCapture()
        end
    end)
end

