-- ========================== ОБРАБОТЧИКИ КОМАНД ==========================
local commandHistory = {}
local histIndex = 0

local function executeCommand(raw, plr)
    local input = raw:gsub("^[;/]", "")
    local parts = {}
    for p in input:gmatch("%S+") do table.insert(parts, p) end
    if #parts == 0 then return end
    local cmd = parts[1]:lower()
    if commands[cmd] then
        local success, result = pcall(commands[cmd].exec, parts, plr)
        if success and result and type(result) == "string" then
            print("[Admin] " .. result)
        elseif not success then
            warn("[Admin] Error: " .. tostring(result))
        end
    else
        print("[Admin] Unknown: " .. cmd .. ". Type ;help")
    end
end

local function sendCommand()
    local txt = cmdInput.Text
    if txt ~= "" then
        table.insert(commandHistory, txt)
        histIndex = #commandHistory
        executeCommand(txt, LocalPlayer)
    end
    cmdInput.Text = ""
    suggestionFrame.Visible = false
end

