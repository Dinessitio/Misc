UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Semicolon or input.KeyCode == Enum.KeyCode.Slash then
        local prefix = (input.KeyCode == Enum.KeyCode.Semicolon) and ";" or "/"
        if not cmdInput:IsFocused() then
			wait(0.03)
            cmdInput:CaptureFocus()
            cmdInput.Text = prefix
            cmdInput.CursorPosition = #prefix + 1
        else
            local pos = cmdInput.CursorPosition
            local text = cmdInput.Text
            cmdInput.Text = text:sub(1, pos-1) .. prefix .. text:sub(pos)
            cmdInput.CursorPosition = pos + 1
        end
    end
end)

