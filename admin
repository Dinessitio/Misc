local function addBulletRow(parent, label, valueFunc, updateInterval)
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 24)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.Parent = parent

    local bullet = Instance.new("TextLabel")
    bullet.Text = "-"
    bullet.TextColor3 = Color3.fromRGB(200, 210, 230)
    bullet.TextSize = 14
    bullet.Font = Enum.Font.SourceSans
    bullet.TextXAlignment = Enum.TextXAlignment.Left
    bullet.BackgroundTransparency = 1
    bullet.Size = UDim2.new(0, 20, 1, 0)
    bullet.Parent = row

    local labelTxt = Instance.new("TextLabel")
    labelTxt.Text = label .. "  "
    labelTxt.TextColor3 = Color3.fromRGB(230, 235, 245)
    labelTxt.TextSize = 14
    labelTxt.Font = Enum.Font.SourceSans
    labelTxt.TextXAlignment = Enum.TextXAlignment.Left
    labelTxt.BackgroundTransparency = 1
    labelTxt.Size = UDim2.new(0, 140, 1, 0)
    labelTxt.Position = UDim2.new(0, 20, 0, 0)
    labelTxt.Parent = row

    local valueTxt = Instance.new("TextLabel")
    local ok, val = pcall(valueFunc)
    valueTxt.Text = ok and tostring(val) or "?"
    valueTxt.TextColor3 = Color3.fromRGB(170, 180, 200)
    valueTxt.TextSize = 14
    valueTxt.Font = Enum.Font.SourceSans
    valueTxt.TextXAlignment = Enum.TextXAlignment.Left
    valueTxt.BackgroundTransparency = 1
    valueTxt.Size = UDim2.new(1, -160, 1, 0)
    valueTxt.Position = UDim2.new(0, 160, 0, 0)
    valueTxt.Parent = row

    if updateInterval then
        task.spawn(function()
            while screenGui.Parent do
                task.wait(updateInterval)
                local ok2, val2 = pcall(valueFunc)
                valueTxt.Text = ok2 and tostring(val2) or "?"
            end
        end)
    end
    return valueTxt
end

